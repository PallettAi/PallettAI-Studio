node_modules/
dist/
.freebuff/
*.log
.DS_Store
supabase/.temp/

# Never stage local credentials or signing material.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key

# Referral-code signing key. This is the ONE secret that must never be
# committed: anyone holding it can mint unlimited Pro entitlements that verify
# offline. `.refcode-private-key*` also catches timestamped backups.
.refcode-private-key*
.hotfix-keys/

# Local design-system preview output (scripts/school-preview.js)
.preview/

# Incremental compiler cache (modules/compiler-cache.js). Derived entirely
# from the project and rebuildable at any time, so it is never source.
.build-cache/
.build-cache-test*

# Project snapshot vault (modules/project-vault.js) and the atomic-write
# temp files it uses. Local recovery data, never source.
.pallettai/
*.pallettai.tmp
.pallettai-smoke/

# Local build scratch, none of it source. `vendor/ai-engine/` is 15 MB of
# vendored WASM that no module requires or references; `assets/` is an OUTPUT
# directory (modules/social-card.js writes og-image.* into it); the `.tmp-*
# directories are model-subsetting caches. Named explicitly rather than
# ignoring all of `vendor/` or `assets/`, so a future real asset or vendored
# dependency is not silently unversioned. Ignored so an ordinary
# `git add .` cannot sweep them into a release.
vendor/ai-engine/
assets/og-image.*
.tmp-subset/
.tmp-model-cache/
.audit-probe.js
